{
  "name": "ai-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "npm run build && wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.5",
    "lucide-react": "0.542.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260904.1",
    "@tailwindcss/vite": "4.1.13",
    "@types/node": "24.6.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "daisyui": "5.1.10",
    "tailwindcss": "4.1.13",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "wrangler": "4.129.0"
  },
  "cloudflare": {
    "bindings": {
      "INGEST_TOKEN": {
        "description": "Secret the Next.js proxy sends as `Authorization: Bearer`. Generate with `openssl rand -hex 32`."
      },
      "API_TOKEN": {
        "description": "Read-API bearer token and the dashboard password. Generate with `openssl rand -hex 32`. Comma-separate several to rotate."
      }
    }
  }
}
